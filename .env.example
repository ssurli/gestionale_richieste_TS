# ============================================================================
# CONFIGURAZIONE MICROSOFT ENTRA ID (Azure AD)
# ============================================================================

# Client ID dell'app registration su Entra ID
# Dove trovarlo: Azure Portal → App registrations → {tua app} → Overview → Application (client) ID
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=your-client-id-here

# Tenant ID della directory Azure
# Dove trovarlo: Azure Portal → App registrations → {tua app} → Overview → Directory (tenant) ID
NEXT_PUBLIC_AZURE_AD_TENANT_ID=your-tenant-id-here

# URL di redirect dopo login (deve corrispondere a quello configurato in Entra ID)
# Sviluppo: http://localhost:3000
# Produzione: https://hta.usltoscananordovest.it
NEXT_PUBLIC_AZURE_AD_REDIRECT_URI=http://localhost:3000


# ============================================================================
# MICROSOFT DATAVERSE
# ============================================================================

# URL dell'organizzazione Dataverse
# Formato: https://{organization}.crm4.dynamics.com
# Dove trovarlo: Power Apps → Settings → Session details → Instance url
# Esempio per Europa: https://orgxxxxxx.crm4.dynamics.com
NEXT_PUBLIC_DATAVERSE_URL=https://your-org.crm4.dynamics.com

# Versione API Dataverse (lasciare v9.2 se non specificato diversamente)
NEXT_PUBLIC_DATAVERSE_API_VERSION=v9.2


# ============================================================================
# MODALITÀ DEMO (solo sviluppo/demo, MAI con dati reali)
# ============================================================================

# Se 'true', l'app è utilizzabile SENZA login Entra ID e senza Dataverse,
# con un utente fittizio locale. Qualsiasi altro valore (o variabile assente)
# richiede la configurazione completa qui sopra: variabili mancanti bloccano
# l'app con un errore esplicito, non la lasciano aperta.
# NEXT_PUBLIC_AUTH_DISABLED=true


# ============================================================================
# CONFIGURAZIONE AMBIENTE
# ============================================================================

# Ambiente di esecuzione (development, production)
NODE_ENV=development

# URL base dell'applicazione
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ============================================================================
# OPZIONALE: Application Insights (Azure)
# ============================================================================

# Connection string per Application Insights (monitoraggio)
# NEXT_PUBLIC_APPINSIGHTS_CONNECTION_STRING=


# ============================================================================
# ISTRUZIONI SETUP
# ============================================================================

# 1. Copia questo file in .env.local:
#    cp .env.example .env.local
#
# 2. Compila i valori sopra con le tue credenziali da Azure Portal
#
# 3. NON committare mai il file .env.local su git (è già nel .gitignore)
#
# 4. Per ottenere le credenziali:
#    a) Vai su https://portal.azure.com
#    b) Azure Active Directory → App registrations → New registration
#    c) Crea app "Gestionale HTA USL TNO"
#    d) Copia Client ID e Tenant ID
#    e) Vai su Power Apps (https://make.powerapps.com)
#    f) Settings → Session details → copia Instance URL
#
# 5. Riavvia il server Next.js dopo aver modificato .env.local:
#    npm run dev
